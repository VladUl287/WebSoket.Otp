<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Version>0.0.2</Version>
		<PackageVersion>$(Version)</PackageVersion>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/VladUl287/WebSoket.Otp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/VladUl287/WebSoket.Otp</RepositoryUrl>

		<PackageIcon>icon.png</PackageIcon>

		<Title>WebSockets.Otp.Core — Minimal WebSocket APIs for ASP.NET Core.</Title>
		<Description>
			A minimal, endpoint-based WebSocket library for ASP.NET Core inspired by REPR and Minimal APIs.
		</Description>
		<PackageTags>websocket, websockets, aspnetcore, aspnet, dotnet, minimal-api, repr, endpoints, real-time, realtime, signalr-alternative, ws, group-broadcast, redis, authorization, dependency-injection</PackageTags>

	</PropertyGroup>

	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath="\" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebSocket.Otp.Abstractions\WebSockets.Otp.Abstractions.csproj" />
	</ItemGroup>

</Project>
